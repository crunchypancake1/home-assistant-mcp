{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "home-assistant-mcp",
  "main": "src/index.ts",
  "compatibility_date": "2026-06-01",
  "compatibility_flags": ["nodejs_compat"],
  "durable_objects": {
    "bindings": [{ "name": "HA_MCP", "class_name": "HomeAssistantMCP" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["HomeAssistantMCP"] }],
  "vars": {
    "HA_URL": "https://home.crunchypancake.com"
  },
  "secrets_store_secrets": [
    {
      "binding": "HA_TOKEN",
      "store_id": "d947ac5bb8ef4800ac46fc59128a1a09",
      "secret_name": "home-assistant-token"
    }
  ],
  "workers_dev": true,
  "routes": [
   { "pattern": "home.crunchypancake.com/mcp", "zone_name": "crunchypancake.com" }
  ],
  "observability": {
    "logs": { "enabled": true, "invocation_logs": true }
  }
}
